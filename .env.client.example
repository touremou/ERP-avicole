# ──────────────────────────────────────────────────────────────────────────
# AviSmart ERP — CONFIGURATION D'UNE INSTANCE CLIENT (mutualisé PlanetHoster)
#
# Copié en `.env` À LA PREMIÈRE INSTALLATION SEULEMENT (deploy-instance.sh,
# MODE=first-install), puis complété À LA MAIN sur le serveur. Les mises à
# jour ne l'envoient, ne le lisent ni ne le modifient JAMAIS : ce fichier est
# la carte d'identité du client. Gardez-en une copie chiffrée (coffre de mots
# de passe) — c'est la seule pièce que le code ne sait pas reconstruire.
#
# Procédure complète : docs/ops/instance-client-planethoster.md
# ──────────────────────────────────────────────────────────────────────────

# ── Identité de l'instance ────────────────────────────────────────────────
APP_NAME="AviSmart"
APP_ENV=production
APP_KEY=                                   # posée par le script (key:generate)
APP_DEBUG=false
# Domaine EXACT du client, en https. La licence peut y être liée (anti-copie) :
# il doit correspondre au --domain du code émis.
APP_URL=https://erp.client-domaine.tld
APP_TIMEZONE=Africa/Conakry
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# ── Isolation sur un compte partagé avec d'autres instances ───────────────
# Noms PROPRES à ce client : cookie de session et préfixe de cache ne doivent
# jamais coïncider avec ceux d'une autre instance du même hébergement.
SESSION_COOKIE=avismart_client_session
CACHE_PREFIX=avismart-client-

# ── Base de données DÉDIÉE (N0C › Bases de données MySQL) ─────────────────
# Une base et un utilisateur propres à ce client, créés AVANT /install.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=""                             # guillemets si caractères spéciaux
# Dossier de `mysqldump` (sauvegardes). Vide = trouvé dans le PATH, ce qui est
# le cas chez PlanetHoster : vérifier en SSH avec `which mysqldump`. À ne
# renseigner (ex. /usr/bin) que si la sauvegarde échoue sur « mysqldump not found ».
DB_DUMP_BINARY_PATH=

# ── Sessions / cache / file d'attente (sans démon : mutualisé) ────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# ── Journalisation ────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ── PWA terrain (sous-domaine app.*) ──────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://app.client-domaine.tld

# ── LICENCE DU CLIENT (monétisation) ──────────────────────────────────────
# « Certificat » : la clé PUBLIQUE Ed25519 qui vérifie les codes de ce client
# (php artisan license:keygen, chez le fournisseur). La clé PRIVÉE ne quitte
# JAMAIS le fournisseur : ni ce serveur, ni GitHub, ni ce fichier.
# Le « token » (code de licence signé) ne va PAS ici : il s'active dans
# l'application (Administration › Licence) et vit en base, table `licenses`.
LICENSE_PUBLIC_KEY=
LICENSE_ENFORCE=true
LICENSE_GRACE_DAYS=7
# Vérification en ligne (révocation / renouvellement). Vide = hors ligne.
LICENSE_SERVER_URL=
LICENSE_CHECK_INTERVAL_HOURS=24
LICENSE_VENDOR_NAME="TechCenter"
LICENSE_VENDOR_ADDRESS=
LICENSE_VENDOR_PHONE=

# ── Sauvegardes ───────────────────────────────────────────────────────────
# Mot de passe des archives : propre à ce client, conservé hors du serveur.
BACKUP_ARCHIVE_PASSWORD=

# ── E-mail (boîte du domaine du client — N0C › Comptes de messagerie) ─────
# MAIL_FROM_ADDRESS DOIT être identique à MAIL_USERNAME chez PlanetHoster.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ── WhatsApp / SMS (optionnels, comptes PROPRES au client) ────────────────
# Fournisseur WhatsApp : log | ultramsg | twilio | wati | callmebot
#   log       = n'envoie RIEN (messages écrits dans les journaux) — défaut ;
#   ultramsg  = forfait mensuel, texte libre : WHATSAPP_API_KEY = token,
#               WHATSAPP_INSTANCE_ID = « instance12345 » ;
#   twilio    = API officielle : clé au format SID:TOKEN (Paramètres › WhatsApp).
# Sans cette ligne, l'application reste en « log » : aucune alerte ne part.
# Ces réglages peuvent aussi se faire dans Paramètres › WhatsApp (prioritaires).
WHATSAPP_DRIVER=log
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_ID=
